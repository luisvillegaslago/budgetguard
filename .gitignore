# IDE
# .idea is personal EXCEPT the shared run configurations: those describe how
# the project is run and are worth versioning, so a fresh clone gets the same
# buttons instead of everyone rebuilding them by hand.
.idea/*
!.idea/runConfigurations/
.vscode/
*.swp
*.swo

# MCP config (contains DB credentials)
.mcp.json

# One-off SQL applied manually to Neon; canonical state lives in database/schema.sql + seed.sql
/*.sql

# Knowledge graph generated by graphify. Everything here is derived and rebuilt
# on demand EXCEPT .graphify_semantic.json, which holds the document-extraction
# layer that cost ~1M tokens to produce and cannot be regenerated for free.
#
# The pattern must be `graphify-out/*`, not `graphify-out/`: git cannot re-include
# a file whose parent DIRECTORY is excluded, so with the directory form the
# negation below is a silent no-op that looks like it works.
graphify-out/*
!graphify-out/.graphify_semantic.json

# Dev notes: instructions, working notes, scratch analysis. Its own git repository
# with its own remote, so it is versioned but never ships with the product. The
# product's own documentation stays in docs/ and is versioned here as usual.
docs/dev/
