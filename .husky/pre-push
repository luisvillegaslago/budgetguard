#!/bin/sh

# Fast local quality gate. Versioning is NOT done here: git freezes the list of
# refs it will send before running this hook, so a release commit created at this
# point would never be part of the push (it would stay local, needing a second
# push). The bump, tag and CHANGELOG happen in CI — see .github/workflows/ci.yml.

echo "Running type checking..."
npm run check-types || exit 1

echo "Running linting..."
npm run lint || exit 1

echo "All checks passed."
exit 0
